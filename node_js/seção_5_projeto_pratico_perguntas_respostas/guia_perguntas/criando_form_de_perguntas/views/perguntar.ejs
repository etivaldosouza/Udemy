<%- include('partials/header.ejs'); %>
<body>
    <%-include('partials/navbar.ejs')  %>
    <div class="container">
        <div class="card" id="formulario-pergunta">
            <div class="card-header">
                <h3>Realizar pergunta</h3>
            </div>
            <div class="card-body">
                <form method="post" action="/salvarpergunta">
                    <label for="" class="lab1">Título</label>
                    <input type="text" placeholder="Título" class="form-control" name="titulo"> <!--name identifica eles no backend-->
                    <label for="" class="lab2">Descrição</label>
                    <textarea name="descricao" id="" placeholder="Descreva sua pergunta aqui" class="form-control"></textarea>
                    <br> 
                    <button type="submit" class=" btn btn-primary">Perguntar</button>
                </form>
                    <!-- Existem várias variações de butões no bootstrap:
                    btn-primary(azul), btn-danger(vermelha),btn-warning(amarela),btn-success(verde)-->
            </div>
        </div>               
    </div>    
</body>
<%- include('partials/footer.ejs'); %>

<!--

classes do bootstrap:

- navbar(cria a barra navbar(barra de menus))
- navbar-light (define a cor dos textos da navbar)
- bg-primary (cor de fundo  da navbar)
- <a classe = "navbar-brand"(alinha o conteudo a esquerda da navbar ) />

-->