<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Estrutura de Repetição</title>
</head>
<body>
    <h3>Método for each</h3>
    <p>for each: siguinifica para cada</p>
    <% produtos.forEach(function (produto) { %>  <!--"para cada produto dentro de produtos"-->
        <hr>
        <h3><%= produto.nome  %>: </h3>
        <h4>R$ <%= produto.preco %> </h4>
    <% }) %>
</body>
</html>


